{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Lumina: CLI Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "lumina",
            "args": ["process", "${workspaceFolder}/tests/fixtures"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Lumina: Interactive Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "lumina.debug",
            "args": ["--interactive"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Lumina: Single File Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "lumina.debug",
            "args": ["${file}"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Lumina: Test Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}
